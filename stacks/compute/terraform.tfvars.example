# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

aws_region = "us-west-2"

# Where the foundation stack keeps its state. Same bucket as backend.hcl.
foundation_state = {
  bucket = "bns-tfstate-CHANGEME"
  key    = "foundation/terraform.tfstate"
  region = "us-west-2"
}

# ------------------------------------------------------------------
# Ops loop rehearsal -- slot rotation, interruption, restore
#
# No physics, no inputs, no image pull. A synthetic payload exercises every
# operational path -- sidecar sync, slot rotation, the CURRENT marker, the
# spot flush, the restore -- for a few dollars on a small instance. Inherited
# from the GW230529 project unchanged; run it once on a fresh account to
# prove the plumbing before any billing-sized node.
# ------------------------------------------------------------------
run_mode             = "ops-rehearsal"
instance_type        = "c7a.2xlarge"
run_name             = "opsloop"
mpi_procs            = 8
rehearsal_payload_gb = 10
root_volume_size_gb  = 100

# Two things get rehearsed and they want different settings, so run it twice
# rather than compromising on one profile: a realistic payload to see the
# sync fit inside the interval, and many small generations to see pruning
# keep the volume bounded (rehearsal_payload_gb = 1, rehearsal_generations
# = 6, sync_interval_minutes = 2, under a fresh run_name).
rehearsal_generations       = 5
checkpoint_generations_kept = 2

# ------------------------------------------------------------------
# Throughput probe: what does this grid actually cost on this instance?
#
# NOT YET RUN. Everything numeric about the BNS on AWS is an estimate until
# it is: sec/iter, memory, checkpoint size, the LORENE import time, the cold
# start. The gallery's own run (Teton, 2 nodes / 768 cores as 32 ranks x 24
# threads, 2026-06-04) took 10 h 33 min to t = 2500 with 43.8 GByte from
# Carpet and ~89 GiB resident; its older Frontera figure is 30 h on 128
# cores. Scaled to one c7a.24xlarge those bracket roughly 20-60 hours, and
# the probe is what collapses that to a number.
#
#   make upload-probe PROBE_MINUTES=90
#
# writes Cactus::terminate = "runtime" and Cactus::max_runtime = 90 into
# bns_probe.par and uploads it. The cap is the cost guard -- nothing else
# bounds how long a run bills for, since auto_shutdown fires when the run
# exits and the production parfile does not exit for a day or more.
#
# Ninety minutes because the reading has to settle: the first minutes are
# dominated by things that happen once, and the hourly checkpoint has to
# fall inside the window. About 105 minutes of instance time, 3-4 USD.
#
# Read the answer with `make throughput`. Then read Carpet's "Total required
# memory" and "GF: vars" lines out of the log, and the checkpoint size out
# of `aws s3 ls`, and write all three into the instance_type decision.
# Repeat on c7a.16xlarge (mpi_procs = 16) if the 24xlarge number is
# comfortable: it is the calmest spot pool of the family in us-west-2.
# ------------------------------------------------------------------
# run_mode            = "simulation"
# instance_type       = "c7a.24xlarge"
# run_name            = "probe-dx8-c7a24"
# parfile             = "bns_probe.par"
# image_tag           = "sha256:CHANGEME"
# mpi_procs           = 24
# omp_threads         = 4
# root_volume_size_gb = 300

# ------------------------------------------------------------------
# Production: the gallery BNS to t = 2500
#
# Requires `make upload-inputs` first -- the parfile and the LORENE data are
# fetched from the bucket, not baked into the image. Put the resolution and
# the end point in run_name: checkpoint_dir is cwd relative, so runs sharing
# a parent directory would let recover=autoprobe pick up the wrong run's
# checkpoint.
#
# 24 ranks x 4 threads is the gallery's Frontera shape on 96 cores. The
# instance type is a placeholder for the probe's answer; the memory case
# for it is in variables.tf.
#
# Pin image_tag to the digest, not "latest". A node relaunched after a spot
# interruption re-pulls the reference it was configured with, and a mutable
# tag can have moved under it mid-run -- the digest cannot. The variable's
# description shows the command that reads it.
# ------------------------------------------------------------------
# run_mode            = "simulation"
# instance_type       = "c7a.24xlarge"
# run_name            = "prod-dx8-2500m"
# parfile             = "bns.par"
# image_tag           = "sha256:CHANGEME"
# mpi_procs           = 24
# omp_threads         = 4
# root_volume_size_gb = 300

# ------------------------------------------------------------------
# Availability zone
# ------------------------------------------------------------------
# Zone NAMES are shuffled per AWS account; zone IDs are not. Run
# `make region-scout` for this account's mapping and current placement
# scores before pinning a value -- the GW230529 project's scout was for a
# 192 vCPU c7a.48xlarge request and does not transfer to a 96 vCPU one.
#
# Spot Advisor, us-west-2, 2026-09-13 (savings vs on-demand / interruption
# frequency): c7a.16xlarge 63% / 5-10%, c7a.24xlarge 62% / >20%,
# c7a.48xlarge 69% / 10-15%. Frequency bands, not prices; the scout prints
# the price.
#
# The zone has to be one the foundation stack put a subnet in: this stack
# looks the subnet up by zone name, so a zone missing from foundation's
# availability_zones fails at plan time rather than falling back.
#
# Null uses foundation's first subnet, which is the first entry of that list
# and therefore the preferred zone -- but say it explicitly for a production
# run, so the intent survives a change to the foundation stack.
# availability_zone = "us-west-2d"

# The run switch. `make run` and `make stop` flip this from the command line;
# leaving it false here means a bare `terraform apply` never starts billing.
run_enabled = false
