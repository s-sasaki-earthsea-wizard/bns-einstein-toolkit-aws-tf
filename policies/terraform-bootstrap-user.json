{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeTheProjectRolesWhichAreWhereEveryOtherPermissionLives",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::*:role/bns-terraform-operator",
        "arn:aws:iam::*:role/bns-observer"
      ]
    },
    {
      "Sid": "ManageOwnAccessKeysBecauseRotationMustNotNeedAnAdministrator",
      "Effect": "Allow",
      "Action": [
        "iam:ListAccessKeys",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:DeleteAccessKey",
        "iam:GetAccessKeyLastUsed"
      ],
      "Resource": "arn:aws:iam::*:user/bns"
    },
    {
      "Sid": "ReadOwnMfaDeviceSoTheProfileCanBeConfigured",
      "Effect": "Allow",
      "Action": [
        "iam:ListMFADevices",
        "iam:GetUser"
      ],
      "Resource": "arn:aws:iam::*:user/bns"
    }
  ]
}
